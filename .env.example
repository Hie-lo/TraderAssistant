# Environment Mode: development / production
ENV_MODE=production

# Telegram Bot Credentials
BOT_TOKEN=7000000000:AAExampleTelegramBotTokenPlaceholder
ADMIN_LOG_CHANNEL_ID=-1001234567890
CHANNEL_ID=
SUPER_ADMIN_IDS=[111111111]

# PostgreSQL Container Credentials (used by db & backend via env_file)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=trading_db

# Database Connection URL (Docker service hostname: db, local SQLite/localhost override for dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/trading_db

# Frontend Telegram Mini-App URL & Port Mapping
MINI_APP_URL=https://your-domain.com
FRONTEND_PORT=127.0.0.1:3000
STORAGE_DIR=storage
LOGS_DIR=logs
