# Environment Mode: development / production
ENV_MODE=development

# Telegram Bot Credentials
BOT_TOKEN=7000000000:AAExampleTelegramBotTokenPlaceholder
ADMIN_LOG_CHANNEL_ID=-1001234567890
SUPER_ADMIN_IDS=[111111111]

# Database Connection URL (PostgreSQL asyncpg or SQLite fallback)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trading_db

# Frontend Telegram Mini-App URL
MINI_APP_URL=http://localhost:5173
STORAGE_DIR=storage
LOGS_DIR=logs
